{%- doc -%}
  Renders an accessible, CSS-only star-rating INPUT (radio group).
  The selected value is submitted as a "x / 5" string so it appears as a
  labelled line in Shopify's contact-form notification email.

  Radios are output 5..1 and visually reversed with flex-direction: row-reverse,
  so the CSS sibling selector can fill the hovered/checked star and all before it.
  Requires the consuming section to define the .star-input styles.

  @param {string} form_id - Unique id prefix so multiple inputs don't collide
  @param {string} [name] - The form field name (default: "contact[Rating]")

  @example
  {% render 'star-rating-input', form_id: form_id %}
{%- enddoc -%}

{%- liquid
  assign _form_id = form_id | default: 'rating'
  assign _name = name | default: 'contact[Rating]'
  assign star_values = '5,4,3,2,1' | split: ','
-%}

<fieldset
  class="star-input"
  role="radiogroup"
  aria-label="{{ 'accessibility.rating_input' | t }}"
>
  {%- for s in star_values -%}
    <input
      class="star-input__radio visually-hidden"
      type="radio"
      id="{{ _form_id }}-star-{{ s }}"
      name="{{ _name }}"
      value="{{ s }} / 5"
      {% if forloop.first %}required{% endif %}
    >
    <label
      class="star-input__label"
      for="{{ _form_id }}-star-{{ s }}"
      aria-label="{{ s }}"
    >
      <svg class="star-input__star" viewBox="0 0 32 32" role="presentation" focusable="false">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
      </svg>
    </label>
  {%- endfor -%}
</fieldset>
