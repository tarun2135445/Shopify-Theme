{{ 'oni-fx.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  polly-fx.css is only used by the editorial-spotlight section, which lives only
  on the homepage — so it's scoped to the index template. It's also loaded
  non-render-blocking: its "before reveal" hidden states only apply once
  polly-fx.js (deferred) adds `.polly-fx-ready`, so it's never needed for first
  paint. The media="print"/onload swap keeps it off the critical render path; the
  <noscript> fallback covers JS-disabled clients.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <link
    rel="stylesheet"
    href="{{ 'polly-fx.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
  <noscript>{{ 'polly-fx.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}
