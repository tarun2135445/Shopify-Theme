          "type": "faq_item",
          "settings": {
            "question": "What sizes are available?",
            "answer": "<p>Our hoodies run true to size and are available from S to XXL. Check the size guide on each product page for exact chest and length measurements.</p>",
            "open_by_default": true
          }
        },
        "q-shipping": {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are printed and dispatched within 2–4 business days. Delivery within India typically takes 4–7 business days after dispatch.</p>"
          }
        },
        "q-returns": {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We accept returns and exchanges within 7 days of delivery on unworn items with tags attached. Custom-designed pieces are made to order and are non-returnable unless faulty.</p>"
          }
        },
        "q-washing": {
          "type": "faq_item",
          "settings": {
            "question": "Are the prints machine washable?",
            "answer": "<p>Yes. Wash inside out on a cold, gentle cycle and air dry to keep the print looking sharp for longer.</p>"
          }
        }
      },
