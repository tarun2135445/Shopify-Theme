{% comment %}
  Custom robots.txt for onitheory.com
  - Preserves Shopify's default crawl rules (cart/checkout/account disallows, sitemap).
  - Explicitly WELCOMES AI answer-engine + generative-search crawlers (AEO/GEO),
    so the brand is eligible to be cited in ChatGPT, Claude, Perplexity, Google AI
    Overviews, Bing Copilot, etc.
  To opt a bot OUT later, change its `Allow: /` to `Disallow: /`.
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent }}
  {% for rule in group.rules %}{{ rule }}
  {% endfor -%}
  {%- if group.sitemap != blank %}
    {{ group.sitemap }}
  {%- endif %}
{% endfor %}

# --- AI answer-engine & generative-search crawlers (AEO/GEO): explicitly allowed ---
{%- assign ai_agents = "GPTBot,OAI-SearchBot,ChatGPT-User,ClaudeBot,anthropic-ai,Claude-Web,Claude-SearchBot,PerplexityBot,Perplexity-User,Google-Extended,Applebot,Applebot-Extended,Bingbot,CCBot,Amazonbot,Meta-ExternalAgent,DuckAssistBot,cohere-ai,YouBot,Diffbot" | split: "," -%}
{%- for agent in ai_agents %}
User-agent: {{ agent }}
Allow: /
Disallow: /cart
Disallow: /checkout
Disallow: /account
Disallow: /*?*sort_by*
Disallow: /*?*filter*
{% endfor -%}
